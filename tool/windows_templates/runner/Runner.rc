// UltraPOS — recursos del ejecutable (versión, nombre, icono, DPI).
//
// Reemplaza a `windows/runner/Runner.rc` generado por `flutter create`.
// Mantiene los mismos `#include` y el mismo bloque de manifiesto que la
// plantilla (para no romper el build) y cambia solo los metadatos del producto.

#include "winres.h"

// Icono del ejecutable. Si el archivo no existe, el runner usa el de Flutter;
// `tool/setup_windows.ps1` copia assets/branding/ultrapos.ico aquí cuando está
// disponible.
IDI_APP_ICON ICON "resources\\app_icon.ico"

// Manifiesto: DPI por monitor (una caja con pantalla 1366x768 y escalado 125 %
// debe verse nítida) y Windows 10/11 declarados.
1 RT_MANIFEST "runner.exe.manifest"

// ---------------------------------------------------------------------------
// Información de versión
// ---------------------------------------------------------------------------

VS_VERSION_INFO VERSIONINFO
  FILEVERSION     1,0,0,0
  PRODUCTVERSION  1,0,0,0
  FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
  FILEFLAGS       VS_FF_DEBUG
#else
  FILEFLAGS       0x0L
#endif
  FILEOS          VOS_NT_WINDOWS32
  FILETYPE        VFT_APP
  FILESUBTYPE     VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    // 0409 = inglés (EE. UU.), 04b0 = Unicode. Windows usa este bloque para el
    // nombre del producto aunque la interfaz esté en español.
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName",      "UltraPOS"
      VALUE "FileDescription",  "UltraPOS - Punto de Venta"
      VALUE "FileVersion",      "1.0.0.0"
      VALUE "InternalName",     "ultrapos"
      VALUE "LegalCopyright",   "Copyright (C) UltraPOS"
      VALUE "OriginalFilename", "ultrapos.exe"
      VALUE "ProductName",      "UltraPOS"
      VALUE "ProductVersion",   "1.0.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    // 0x04b0 (1200) = Unicode.
    VALUE "Translation", 0x409, 1200
  END
END
